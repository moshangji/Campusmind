# 百川——校园智心守护系统 配置示例

# === 百度翻译（必需，用于中文→英文） ===
BAIDU_TRANSLATE_APPID=你的_appid
BAIDU_TRANSLATE_SECRET=你的_密钥

# === 大模型（干预回复、多模态，选一个即可） ===
DEEPSEEK_API_KEY=你的_deepseek_api_key
# DOUBAO_API_KEY=你的_豆包_api_key
# BAICHUAN_API_KEY=你的_百川_api_key

# === 默认大模型提供商 ===
LLM_PROVIDER=deepseek

# === JWT 认证密钥 ===
JWT_SECRET=请替换为一个随机字符串

# === 校级管理员注册密钥（注册 role=school_admin 时必填，且须填写 school_id）===
ADMIN_REGISTER_SECRET=请自行填写校级管理员注册密钥

# === 超级管理员注册密钥（注册 role=super_admin 时必填；与校级密钥分离）===
SUPER_ADMIN_REGISTER_SECRET=请自行填写超级管理员注册密钥

# === MySQL 数据库（可选，不配置则跳过数据持久化） ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campusmind
DB_PASSWORD=你的数据库密码
DB_NAME=campusmind

# === 已登录用户：大模型多轮上下文从 MySQL 取的最近对话「行」数（默认 6，上限 20）===
# 情感识别与风险评估仍只对当前一句执行，不把历史句送入判别/翻译链路。
CHAT_CONTEXT_MAX_TURNS=6
